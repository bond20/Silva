<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="serif"
        android:text="@string/title_app_name_homepage"
        android:textAllCaps="true"
        android:textSize="64sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.046" />

    <TextView
        android:id="@+id/sleep_text"
        android:layout_width="141dp"
        android:layout_height="27dp"
        android:fontFamily="sans-serif"
        android:text="@string/title_sleep_analysis_homepage"
        android:textAlignment="center"
        android:textSize="20sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/information_text"
        app:layout_constraintHorizontal_bias="0.478"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.47" />

    <TextView
        android:id="@+id/information_text"
        android:layout_width="115dp"
        android:layout_height="25dp"
        android:layout_marginEnd="60dp"
        android:text="@string/title_information_homepage"
        android:textAlignment="center"
        android:textSize="20sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.468" />

    <ImageView
        android:id="@+id/SleepAnalysisIcon"
        android:layout_width="125dp"
        android:layout_height="126dp"
        android:contentDescription="@string/icon_sleep_analysis_homepage"
        app:layout_constraintBottom_toTopOf="@+id/sleep_text"
        app:layout_constraintEnd_toEndOf="@+id/sleep_text"
        app:layout_constraintHorizontal_bias="0.562"
        app:layout_constraintStart_toStartOf="@+id/sleep_text"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="1.0"
        app:srcCompat="@drawable/sleep_cartoon_art_copyrighted"
        tools:srcCompat="@drawable/sleep_cartoon_art_copyrighted" />

    <ImageView
        android:id="@+id/InformationIcon"
        android:layout_width="125dp"
        android:layout_height="125dp"
        android:contentDescription="@string/icon_information_homepage"
        android:fadingEdge="horizontal|vertical|none"
        app:layout_constraintBottom_toTopOf="@+id/information_text"
        app:layout_constraintEnd_toEndOf="@+id/information_text"
        app:layout_constraintStart_toStartOf="@+id/information_text"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.995"
        app:srcCompat="@drawable/information_cartoon_copyrighted"
        tools:srcCompat="@drawable/information_cartoon_copyrighted" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="invisible"
        app:labelVisibilityMode="labeled"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:menu="@menu/bottom_navigation" />

    <ImageButton
        android:id="@+id/ToDoIcon"
        android:layout_width="125dp"
        android:layout_height="125dp"
        android:layout_marginTop="48dp"
        android:adjustViewBounds="false"
        android:background="#FFFFFF"
        android:contentDescription="@string/to_do_icon"
        android:cropToPadding="false"
        android:scaleType="centerInside"
        app:layout_constraintEnd_toEndOf="@+id/to_do_text"
        app:layout_constraintHorizontal_bias="0.448"
        app:layout_constraintStart_toStartOf="@+id/to_do_text"
        app:layout_constraintTop_toBottomOf="@+id/sleep_text"
        app:srcCompat="@drawable/vectorstock_6342160"
        tools:srcCompat="@drawable/vectorstock_6342160" />

    <TextView
        android:id="@+id/to_do_text"
        android:layout_width="96dp"
        android:layout_height="26dp"
        android:text="@string/title_to_do_list"
        android:textAlignment="center"
        android:textSize="20sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.212"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ToDoIcon" />

    <ImageView
        android:id="@+id/CalendarIcon"
        android:layout_width="125dp"
        android:layout_height="125dp"
        android:layout_marginTop="48dp"
        app:layout_constraintEnd_toEndOf="@+id/textView6"
        app:layout_constraintHorizontal_bias="0.52"
        app:layout_constraintStart_toStartOf="@+id/textView6"
        app:layout_constraintTop_toBottomOf="@+id/information_text"
        app:srcCompat="@drawable/vectorstock_58511273"
        tools:srcCompat="@drawable/vectorstock_58511273" />

    <TextView
        android:id="@+id/textView6"
        android:layout_width="142dp"
        android:layout_height="26dp"
        android:text="Event Calendar"
        android:textAlignment="center"
        android:textSize="20sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.51"
        app:layout_constraintStart_toEndOf="@+id/to_do_text"
        app:layout_constraintTop_toBottomOf="@+id/CalendarIcon" />

</androidx.constraintlayout.widget.ConstraintLayout>