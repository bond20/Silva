<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".SleepAnalysis">

    <TextView
        android:id="@+id/textView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="169dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="169dp"
        android:fontFamily="sans-serif-smallcaps"
        android:text="@string/title_sleep_analysis_page"
        android:textAlignment="center"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/rec_info"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/rec_info"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/roundedbutton"
        android:text="i"
        app:layout_constraintBottom_toTopOf="@+id/Set_time"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.891"
        app:layout_constraintStart_toStartOf="parent" />

    <ImageView
        android:id="@+id/Set_time"
        android:layout_width="170dp"
        android:layout_height="170dp"
        android:layout_marginBottom="32dp"
        app:layout_constraintBottom_toTopOf="@+id/textView4"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.481"
        app:layout_constraintStart_toStartOf="parent"
        app:srcCompat="@drawable/roundedtime" />

    <EditText
        android:id="@+id/time_dialog"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAlignment="center"
        android:hint="00:00"
        android:textSize="30sp"
        app:layout_constraintBottom_toBottomOf="@+id/Set_time"
        app:layout_constraintEnd_toEndOf="@+id/Set_time"
        app:layout_constraintStart_toStartOf="@+id/Set_time"
        app:layout_constraintTop_toTopOf="@+id/Set_time" />

    <TextView
        android:id="@+id/textView4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:height="40dp"
        android:text="@string/text_sleep_analysis_2"
        app:layout_constraintBottom_toTopOf="@+id/rec_ime_1"
        app:layout_constraintEnd_toEndOf="@id/rec_ime_1"
        app:layout_constraintHorizontal_bias="0.946"
        app:layout_constraintStart_toStartOf="@id/rec_ime_1" />

    <Button
        android:id="@+id/rec_ime_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Start"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.9"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.613" />

    <EditText
        android:id="@+id/setalarm"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="00:00"
        app:layout_constraintBottom_toBottomOf="@+id/rec_ime_1"
        app:layout_constraintEnd_toStartOf="@+id/rec_ime_1"
        app:layout_constraintHorizontal_bias="0.855"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/rec_ime_1"
        app:layout_constraintVertical_bias="1.0" />

    <TextView
        android:id="@+id/textView5"
        android:layout_width="155dp"
        android:layout_height="35dp"
        android:text="The recommended wake up time:"
        android:layout_marginRight="20dp"
        app:layout_constraintBottom_toBottomOf="@+id/setalarm"
        app:layout_constraintEnd_toStartOf="@+id/setalarm"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/setalarm"
        app:layout_constraintVertical_bias="0.5" />

</androidx.constraintlayout.widget.ConstraintLayout>